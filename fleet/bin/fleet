#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  DEVICES_PATH,
  endpoint,
  expandHome,
  loadDevices,
  probe,
  resolveTargets,
  run,
  shellQuote,
  sshArguments,
} from "../lib/core.mjs";

const HELP = [
  "用法：",
  "  fleet ls",
  "  fleet exec <target> [--timeout SECONDS] [--json] -- <command>",
  "  fleet push <target> <src> <dst>",
  "  fleet pull <target> <src> <dst>",
  "  fleet logs <target> <path> [--tail N]",
  "",
  "target 是设备名或 tag:<标签>。多设备目标按顺序执行。",
  "设备清单：" + DEVICES_PATH,
  "",
  "子命令：",
  "  ls       列出设备和 SSH 可达性",
  "  exec     在目标设备执行命令",
  "  push     上传文件",
  "  pull     下载文件",
  "  logs     读取远端文件末尾内容",
].join("\n");

const COMMAND_HELP = {
  ls: [
    "用法：fleet ls",
    "",
    "列出设备清单中的设备、架构、标签和 SSH 可达性。disabled 设备不会发起连接。",
  ].join("\n"),
  exec: [
    "用法：fleet exec <target> [--timeout SECONDS] [--json] -- <command>",
    "",
    "在设备名或 tag:<标签> 指定的设备上串行执行命令，输出带设备名前缀。",
    "--timeout 为每台设备的执行超时，超时退出码为 124。",
    "--json 输出每台设备的结构化执行结果，包含设备端真实退出码和传输状态。",
  ].join("\n"),
  push: [
    "用法：fleet push <target> <src> <dst>",
    "",
    "使用 SSH 密钥将本地文件上传到目标设备。",
  ].join("\n"),
  pull: [
    "用法：fleet pull <target> <src> <dst>",
    "",
    "使用 SSH 密钥从目标设备下载文件。tag 匹配多台设备时写入 <dst>/<设备名>/。",
  ].join("\n"),
  logs: [
    "用法：fleet logs <target> <path> [--tail N]",
    "",
    "读取目标设备远端文件的末尾内容，默认读取最后 100 行。",
  ].join("\n"),
};

function fail(message, exitCode = 1) {
  console.error("fleet: " + message);
  process.exit(exitCode);
}

function writePrefixed(name, content, stream) {
  if (!content) return;
  for (const line of content.split(/\r?\n/)) {
    if (line) stream.write("[" + name + "] " + line + "\n");
  }
}

function resultCode(result) {
  if (result.timedOut) return 124;
  if (result.transportError) return result.code ?? 1;
  return result.remoteCode ?? result.code;
}

function runForTargets(targets, action, options = {}) {
  let failed = false;
  for (const device of targets) {
    const result = action(device);
    if (options.json) {
      process.stdout.write(JSON.stringify({
        schema_version: 1,
        device: device.name,
        exit_code: result.remoteCode ?? null,
        process_exit_code: result.code ?? null,
        timed_out: Boolean(result.timedOut),
        transport_error: Boolean(result.transportError),
        signal: result.signal ?? null,
        error: result.error ?? null,
        stdout: result.stdout ?? "",
        stderr: result.stderr ?? "",
      }) + "\n");
    } else {
      writePrefixed(device.name, result.stdout, process.stdout);
      writePrefixed(device.name, result.stderr, process.stderr);
    }
    const code = resultCode(result);
    if (code !== 0) {
      failed = true;
      if (!options.json) process.stderr.write("[" + device.name + "] 退出码：" + code + "\n");
    }
  }
  return failed ? 1 : 0;
}

function configuredDevices() {
  return loadDevices(process.env.FLEET_DEVICES_PATH ? path.resolve(process.env.FLEET_DEVICES_PATH) : undefined);
}

function commandLs() {
  const devices = configuredDevices();
  let failed = false;
  console.log("NAME\tHOST\tARCH\tTAGS\tENABLED\tSTATUS");
  for (const device of devices) {
    if (!device.enabled) {
      console.log(device.name + "\t" + device.host + "\t" + device.arch + "\t" + device.tags.join(",") + "\tfalse\tdisabled");
      continue;
    }
    const result = probe(device);
    const status = result.code === 0 ? "reachable" : "unreachable";
    console.log(device.name + "\t" + device.host + "\t" + device.arch + "\t" + device.tags.join(",") + "\ttrue\t" + status);
    if (result.code !== 0) failed = true;
  }
  return failed ? 1 : 0;
}

function commandExec(args) {
  const separator = args.indexOf("--");
  if (separator < 1 || separator === args.length - 1) fail(COMMAND_HELP.exec, 2);
  let timeout;
  let json = false;
  for (let index = 1; index < separator; index += 1) {
    if (args[index] === "--json") {
      json = true;
      continue;
    }
    if (args[index] !== "--timeout" || index + 1 >= separator) fail(COMMAND_HELP.exec, 2);
    const seconds = Number(args[index + 1]);
    if (!Number.isInteger(seconds) || seconds < 1) fail("--timeout 必须是正整数秒数。", 2);
    timeout = seconds * 1000;
    index += 1;
  }
  const devices = configuredDevices();
  const targets = resolveTargets(devices, args[0]);
  const command = args.slice(separator + 1).map(shellQuote).join(" ");
  const marker = "__FLEET_REMOTE_EXIT__";
  return runForTargets(targets, (device) => {
    const key = expandHome(String(device.ssh_key));
    if (!fs.existsSync(key)) {
      return { code: 1, stdout: "", stderr: "SSH 密钥不存在：" + key, transportError: true, remoteCode: null };
    }
    const wrappedCommand = "sh -c " + shellQuote(command)
      + "; remote_code=$?; printf '%s%s\\n' " + shellQuote(marker) + " \"$remote_code\"; exit 0";
    const result = run("ssh", [...sshArguments(device), wrappedCommand], timeout);
    if (result.timedOut || result.error) {
      return { ...result, transportError: true, remoteCode: null };
    }
    const markerMatch = /__FLEET_REMOTE_EXIT__(\d+)(?:\r?\n)?$/.exec(result.stdout);
    if (!markerMatch) {
      return { ...result, transportError: true, remoteCode: null, error: "远端执行结果缺少退出码标记。" };
    }
    const remoteCode = Number(markerMatch[1]);
    return {
      ...result,
      stdout: result.stdout.slice(0, markerMatch.index),
      remoteCode,
      transportError: false,
    };
  }, { json });
}

function commandCopy(command, args) {
  if (args.length !== 3) fail(COMMAND_HELP[command], 2);
  const devices = configuredDevices();
  const targets = resolveTargets(devices, args[0]);
  const source = args[1];
  const destination = args[2];
  return runForTargets(targets, (device) => {
    const key = expandHome(String(device.ssh_key));
    if (!fs.existsSync(key)) {
      return { code: 1, stdout: "", stderr: "SSH 密钥不存在：" + key };
    }
    const connectionArgs = sshArguments(device);
    const remotePath = endpoint(device) + ":" + shellQuote(command === "push" ? destination : source);
    const localDestination = command === "pull" && targets.length > 1
      ? path.join(destination, device.name)
      : destination;
    if (command === "pull" && targets.length > 1) {
      fs.mkdirSync(localDestination, { recursive: true });
    }
    const copyArgs = [
      "-O",
      ...(command === "pull" ? ["-T"] : []),
      ...connectionArgs.slice(0, -1),
      "--",
      command === "push" ? source : remotePath,
      command === "push" ? remotePath : localDestination,
    ];
    return run("scp", copyArgs);
  });
}

function commandLogs(args) {
  if (args.length < 2) fail(COMMAND_HELP.logs, 2);
  const devices = configuredDevices();
  const targets = resolveTargets(devices, args[0]);
  const remotePath = args[1];
  let tail = 100;
  for (let index = 2; index < args.length; index += 1) {
    if (args[index] !== "--tail" || index + 1 >= args.length) fail(COMMAND_HELP.logs, 2);
    tail = Number(args[index + 1]);
    if (!Number.isInteger(tail) || tail < 1) fail("--tail 必须是正整数。", 2);
    index += 1;
  }
  const command = ["tail", "-n", String(tail), "--", remotePath].map(shellQuote).join(" ");
  return runForTargets(targets, (device) => {
    const key = expandHome(String(device.ssh_key));
    if (!fs.existsSync(key)) {
      return { code: 1, stdout: "", stderr: "SSH 密钥不存在：" + key };
    }
    return run("ssh", [...sshArguments(device), command]);
  });
}

function main() {
  const args = process.argv.slice(2);
  if (args.length === 0 || args[0] === "--help" || args[0] === "-h") {
    console.log(HELP);
    process.exit(args.length === 0 ? 2 : 0);
  }

  const command = args.shift();
  if (!(command in COMMAND_HELP)) fail("未知子命令：" + command + "\n\n" + HELP, 2);
  if (args[0] === "--help" || args[0] === "-h") {
    console.log(COMMAND_HELP[command]);
    return;
  }

  try {
    let code;
    if (command === "ls") {
      if (args.length > 0) fail(COMMAND_HELP.ls, 2);
      code = commandLs();
    } else if (command === "exec") {
      code = commandExec(args);
    } else if (command === "push" || command === "pull") {
      code = commandCopy(command, args);
    } else {
      code = commandLogs(args);
    }
    process.exitCode = code;
  } catch (error) {
    fail(error instanceof Error ? error.message : String(error));
  }
}

if (process.argv[1] === fileURLToPath(import.meta.url)) main();
